{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kimizukann/config.schema.json",
  "title": "Kimizukann Simulation Config",
  "type": "object",
  "required": ["schema_version", "model_version", "seed", "grid", "lineages", "inflow_tick_mask"],
  "properties": {
    "schema_version": {"type": "string"},
    "model_version": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0},
    "grid": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "lineages": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["id", "trait_vector", "mechanism_tags"], "properties": {"id": {"type": "string"}, "trait_vector": {"type": "object"}, "mechanism_tags": {"type": "object"}}, "additionalProperties": true}},
    "inflow_tick_mask": {"type": "array", "items": {"type": "integer", "minimum": 0}}
  },
  "additionalProperties": false
}
