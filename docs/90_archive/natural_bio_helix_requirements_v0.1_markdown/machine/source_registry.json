    {
      "source_key": "P05",
      "source_id": "CHAT-005",
      "origin_type": "conversation",
      "category": "product",
      "statement": "段階的リリースとローカル／クラウド併用のハイブリッドモデルで進める。"
    },
    {
      "source_key": "P06",
      "source_id": "CHAT-006",
      "origin_type": "conversation",
      "category": "product",
      "statement": "POは企画から要件定義までを主導し、その下流実装はHELIXとAI開発ラインへ委譲する。"
    },
    {
      "source_key": "P07",
      "source_id": "CHAT-007",
      "origin_type": "conversation",
      "category": "product",
      "statement": "研究モードは初期売上の成立後に専門家監修を導入して拡張する。"
    },
    {
      "source_key": "P08",
      "source_id": "CHAT-008",
      "origin_type": "conversation",
      "category": "product",
      "statement": "考えることを好む大人、サイエンス動画視聴者、育成・戦略・シミュレーション愛好者を主要顧客とする。"
    },
    {
      "source_key": "P09",
      "source_id": "CHAT-009",
      "origin_type": "conversation",
      "category": "product",
      "statement": "目標体験は「生物版マインクラフト」、すなわち生命法則をクラフトし生命史を生成するサンドボックスである。"
    },
    {
      "source_key": "P10",
      "source_id": "CHAT-010",
      "origin_type": "conversation",
      "category": "product",
      "statement": "写実表現を必須とせず、プリミティブ・器官・模様・挙動の合成で生物表現を生成する。"
    },
    {
      "source_key": "P11",
      "source_id": "CHAT-011",
      "origin_type": "conversation",
      "category": "product",
      "statement": "科学法則と因果の可視化を、フォトリアル表現より優先する。"
    },
    {
      "source_key": "P12",
      "source_id": "CHAT-012",
      "origin_type": "conversation",
      "category": "product",
      "statement": "開発時の参考機としてRAM 32GB／VRAM 8GB級を想定するが、MVPはより低い環境でも動作可能な2D構成から始める。"
    },
    {
      "source_key": "P13",
      "source_id": "CHAT-013",
      "origin_type": "conversation",
      "category": "product",
      "statement": "Webを制作・実験・分析の中核とし、スマホを観察・通知・簡易介入・共有端末として位置づける。"
    },
    {
      "source_key": "P14",
      "source_id": "CHAT-014",
      "origin_type": "conversation",
      "category": "product",
      "statement": "通常シミュレーションはローカル実行を基本とし、長期・大量seed・高精度処理はクラウドへ逃がせる。"
    },
    {
      "source_key": "P15",
      "source_id": "CHAT-015",
      "origin_type": "conversation",
      "category": "business",
      "statement": "機能解放型サブスクリプション、演算クレジット、コンテンツ販売を組み合わせられる。"
    },
    {
      "source_key": "P16",
      "source_id": "CHAT-016",
      "origin_type": "conversation",
      "category": "business",
      "statement": "ユーザー作成の「もしもシリーズ」を販売可能なUGC市場として提供する。"
    },
    {
      "source_key": "P17",
      "source_id": "CHAT-017",
      "origin_type": "conversation",
      "category": "business",
      "statement": "UGC作者は無料または任意価格を設定でき、収益分配を受けられる。"
    },
    {
      "source_key": "P18",
      "source_id": "CHAT-018",
      "origin_type": "conversation",
      "category": "business",
      "statement": "YouTube等で仮説を語る文化を形成し、ゲーム内生命史を動画へ変換できる。"
    },
    {
      "source_key": "P19",
      "source_id": "CHAT-019",
      "origin_type": "conversation",
      "category": "business",
      "statement": "開発者・配信者向けに、AI解説によるライブ番組化を将来提供できる。"
    },
    {
      "source_key": "P20",
      "source_id": "CHAT-020",
      "origin_type": "conversation",
      "category": "product",
      "statement": "本製品はHELIXの要求追跡・AI実装・検証能力を実証するリファレンス製品となる。"
    },
    {
      "source_key": "M01",
      "source_id": "CHAT-021",
      "origin_type": "conversation",
      "category": "mode",
      "statement": "育成モード、学習モード、実験モード、研究モードの4モードを設ける。"
    },
    {
      "source_key": "M02",
      "source_id": "CHAT-022",
      "origin_type": "conversation",
      "category": "mode",
      "statement": "育成モードは直感的操作と結果観察を中心とする。"
    },
    {
      "source_key": "M03",
      "source_id": "CHAT-023",
      "origin_type": "conversation",
      "category": "mode",
      "statement": "学習モードは同一結果を生物・化学・物理の因果として段階的に解説する。"
    },
    {
      "source_key": "M04",
      "source_id": "CHAT-024",
      "origin_type": "conversation",
      "category": "mode",
      "statement": "実験モードは対照群、条件固定、比較、仮説検証、再実験を支援する。"
    },
    {
      "source_key": "M05",
      "source_id": "CHAT-025",
      "origin_type": "conversation",
      "category": "mode",
      "statement": "研究モードは方程式、solver、外部モデル、詳細パラメータを扱う上位機能とする。"
    },
    {
      "source_key": "M06",
      "source_id": "CHAT-026",
      "origin_type": "conversation",
      "category": "mode",
      "statement": "細胞、多細胞・組織、個体・動物、生態系、惑星・衛星・彗星へスケールを変更できる。"
    },
    {
      "source_key": "M07",
      "source_id": "CHAT-027",
      "origin_type": "conversation",
      "category": "mode",
      "statement": "説明粒度はモードごとに変更し、基礎説明から研究レベルの不確実性まで連続的に提示する。"
    },
    {
      "source_key": "M08",
      "source_id": "CHAT-028",
      "origin_type": "conversation",
      "category": "interaction",
      "statement": "コドン編集は初心者向けパズル、中級者向けコドン、上級者向け塩基・発現条件へ段階化する。"
    },
    {
      "source_key": "M09",
      "source_id": "CHAT-029",
      "origin_type": "conversation",
      "category": "interaction",
      "statement": "環境生成、生物原種、成長特性、進化仮説にガチャ的な世界生成を適用できる。"
    },
    {
      "source_key": "M10",
      "source_id": "CHAT-030",
      "origin_type": "conversation",
      "category": "interaction",
      "statement": "知識がないプレイヤーへ簡易ガイド、推奨ピース、原因説明、自動修復候補を提供する。"
    },
    {
      "source_key": "M11",
      "source_id": "CHAT-031",
      "origin_type": "conversation",
      "category": "interaction",
      "statement": "知識のあるプレイヤーは手動で環境、遺伝子、発現、突然変異、初期個体群を編集できる。"
    },
    {
      "source_key": "S01",
      "source_id": "CHAT-032",
      "origin_type": "conversation",
      "category": "simulation",
      "statement": "プレイヤーは1個体ではなく、各系統の複数個体を設計・生成して環境へ投入する。"
    },
    {
      "source_key": "S02",
      "source_id": "CHAT-033",
      "origin_type": "conversation",
      "category": "simulation",
      "statement": "初期個体数、比率、配置、接触順序は系統固定の結果へ影響する。"
    },
    {
      "source_key": "S03",
      "source_id": "CHAT-034",
      "origin_type": "conversation",
      "category": "simulation",
      "statement": "安定2系統・突出1系統・意図的劣位1系統は代表的なチュートリアル設計とするが固定ルールにはしない。"
