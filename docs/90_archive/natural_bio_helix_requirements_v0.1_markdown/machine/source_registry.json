  "sources": [
    {
      "source_key": "P01",
      "source_id": "CHAT-001",
      "origin_type": "conversation",
      "category": "product",
      "statement": "本製品をHELIX完成後の最初のプロダクトとして位置づける。"
    },
    {
      "source_key": "P02",
      "source_id": "CHAT-002",
      "origin_type": "conversation",
      "category": "product",
      "statement": "Webアプリケーションとスマートフォンアプリケーションへ展開できる構成とする。"
    },
    {
      "source_key": "P03",
      "source_id": "CHAT-003",
      "origin_type": "conversation",
      "category": "product",
      "statement": "Unity等の高表現ゲームクライアントは、コアの面白さと売上を確認した後に追加できる。"
    },
    {
      "source_key": "P04",
      "source_id": "CHAT-004",
      "origin_type": "conversation",
      "category": "product",
      "statement": "最重要領域はシミュレーションコアであり、企画・要求・要件の中で最も細密に定義する。"
