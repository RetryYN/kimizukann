{
  "version": 1,
  "rules": [
    {
      "paths": ["crates/**/tests/**", "docs/20_design/basic/08_*.md"],
      "allOf": ["kimi", "claude"]
    },
    {
      "paths": ["crates/**"],
      "allOf": ["kimi"],
      "writers": ["grok"]
    },
    {
      "paths": ["docs/20_design/basic/**", "docs/30_contracts/**"],
      "allOf": ["grok"]
    },
    {
      "paths": ["docs/30_contracts/golden/**"],
      "allOf": ["claude"],
      "exclusive": true
    },
    {
      "paths": ["docs/20_design/adr/**", "docs/20_design/basic/05_contract.md", "docs/20_design/basic/07_determinism_model.md"],
      "allOf": ["claude"]
    },
    {"paths": ["docs/20_design/detail/**"], "allOf": ["kimi"]},
    {
      "paths": ["app/**"],
      "allOf": ["kimi", "claude"],
      "writers": ["grok"],
      "merge": "kimi"
    },
    {"paths": [".github/**", ".githooks/**", "scripts/**"], "allOf": ["grok"]},
    {"paths": ["docs/10_requirements/**", "docs/20_design/rfc/**"], "allOf": ["owner"]},
    {"paths": ["docs/20_design/basic/02_glossary.md"], "allOf": ["kimi"]},
    {"paths": ["docs/30_contracts/**"], "allOf": ["claude"]},
    {"paths": ["docs/40_process/**", "docs/50_records/**", "README*"], "allOf": ["claude"]},
    {"paths": ["docs/calib/**"], "allOf": ["grok"]},
    {"paths": ["docs/dist/**"], "allOf": ["grok"]}
  ]
}
