{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Natural Bio Requirements Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "baseline_version": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "title",
          "statement",
          "source_ids",
          "priority",
          "target_release",
          "acceptance_criteria",
          "verification_method"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^(BR|UR|FR|SIM|NFR|HLX|REL)-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "enum": [
              "Must",
              "Should",
              "Could",
              "Won't"
            ]
          },
          "target_release": {
            "pattern": "^R[0-7]$"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "verification_method": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string"
          },
          "tags": {
            "type": "array"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}